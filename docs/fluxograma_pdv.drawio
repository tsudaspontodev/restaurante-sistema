idth="46" height="18" as="geometry"/></mxCell><mxCell id="281" value="Tabela do banco" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1418" y="256" width="230" height="22" as="geometry"/></mxCell><mxCell id="282" value='&lt;font color="#2d7600"&gt;&lt;b&gt;C&lt;/b&gt;reate · &lt;b&gt;R&lt;/b&gt;ead · &lt;b&gt;U&lt;/b&gt;pdate · &lt;b&gt;D&lt;/b&gt;elete&lt;/font&gt; (seta verde tracejada)' style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1360" y="272" width="290" height="20" as="geometry"/></mxCell><mxCell id="283" value="&lt;b&gt;Regras de negócio&lt;/b&gt;&lt;br&gt;• Só produtos com &lt;i&gt;ativo = 1&lt;/i&gt; aparecem e são aceitos.&lt;br&gt;• Preço é sempre lido do banco (o navegador envia só id e qtd).&lt;br&gt;• Pedido nasce pago: status_conta = fechada.&lt;br&gt;• Itens vão para a cozinha (na_cozinha).&lt;br&gt;• Senha = nº do pedido (3 dígitos)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#bbbbbb;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1180" y="620" width="330" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3 - Caixa: mapa de mesas e conta"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="31" value="Caixa — mapa de mesas, entrega de itens e fechamento de conta" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="32" value="Operador&lt;br&gt;no caixa" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#000000;" ver